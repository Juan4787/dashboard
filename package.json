{
	"name": "turnos-saas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"check": "pnpm --filter @turnos-saas/shared check && pnpm --filter web check",
		"test": "pnpm --filter web test",
		"test:e2e": "pnpm --filter web test:e2e",
		"preflight:staging": "pnpm --filter web preflight:staging",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
		"supabase:db:reset": "supabase db reset"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.105.4",
		"@sveltejs/kit": "^2.59.1",
		"web-push": "^3.6.7",
		"ws": "^8.20.1"
	}
}
